    "languages": ["zh"],
    "protocol": {
      "major": 1,
      "minimumMinor": 0,
      "requiredCapabilities": ["media.catalog.v1", "http.request.v1"],
      "optionalCapabilities": []
    },
    "permissions": {
      "api": {
        "origins": ["https://api.copy202602.com", "https://api.mangacopy.com"],
